model Review {
  id         String   @id @default(uuid())
  rating     Int
  comment    String
  tenantId   String
  propertyId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   User     @relation(fields: [tenantId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
}